(footprint "Jack_3.5mm_PJ-3200B-4A_Horizontal" (version 20211014) (generator pcbnew)
  (layer "F.Cu")
  (descr "Korean Hroparts Elec PJ-3200B-4A - 3.5 mm 4-conductor (TRRS) headset jack, 100% through-hole (LCSC C136687). rev-11: pad/hole geometry REBUILT from the LCEDA/EasyEDA library land pattern for C136687 (uuid 5ce7ce35, cross-checked with easyeda2kicad v1.0.1) - the rev-8 hand-drawn version put the Sleeve pad and the two locating posts in the wrong places and JLC's SMT DFM check rejected it. Real land pattern: three 0.9x1.8 mm slotted pads in a row at 4.00 / 3.34 mm pitch (T-R1-R2), an offset Sleeve pad, and two 1.5 mm NPTH locating posts 7.0 mm apart straddling the pad row. Footprint rotated +90 deg from LCEDA-native so the barrel points -Y and overhangs the -Y board edge (old convention: J2-J5 rot 0, J6 rot 180). Pin->function kept from rev-8 (datasheet schematic + KiCad PJ320E cross-check): T=LCEDA pin 2, R1=pin 4, R2=pin 3, S=pin 1. CONFIRM T vs R2 against the PJ-3200B-4A datasheet before ordering.")
  (tags "3.5mm jack trrs 4-conductor headset audio through-hole PJ-3200B-4A KoreanHropartsElec HRO")
  (attr through_hole)
  (fp_text reference "REF**" (at 4.7 -1.5) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "Jack_3.5mm_PJ-3200B-4A_Horizontal" (at 0 6.4) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text user "${REFERENCE}" (at 4.7 -1.5) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))

  (fp_line (start -3.05 -9.35) (end 3.05 -9.35) (layer "F.Fab") (width 0.1))
  (fp_line (start 3.05 -9.35) (end 3.05 4.75) (layer "F.Fab") (width 0.1))
  (fp_line (start 3.05 4.75) (end -3.05 4.75) (layer "F.Fab") (width 0.1))
  (fp_line (start -3.05 4.75) (end -3.05 -9.35) (layer "F.Fab") (width 0.1))

  (fp_line (start -3.5 -5.2) (end -3.5 -3.4) (layer "F.SilkS") (width 0.12))
  (fp_line (start 3.5 -5.2) (end 3.5 -3.4) (layer "F.SilkS") (width 0.12))
  (fp_line (start -3.5 5.2) (end -3.5 3.4) (layer "F.SilkS") (width 0.12))
  (fp_line (start 3.5 5.2) (end 3.5 3.4) (layer "F.SilkS") (width 0.12))
  (fp_line (start -3.9 3.2) (end -3.9 5.2) (layer "F.SilkS") (width 0.15))

  (fp_line (start -4.1 -9.55) (end 4.1 -9.55) (layer "F.CrtYd") (width 0.05))
  (fp_line (start 4.1 -9.55) (end 4.1 6.0) (layer "F.CrtYd") (width 0.05))
  (fp_line (start 4.1 6.0) (end -4.1 6.0) (layer "F.CrtYd") (width 0.05))
  (fp_line (start -4.1 6.0) (end -4.1 -9.55) (layer "F.CrtYd") (width 0.05))

  (pad "T"  thru_hole rect (at 2.2 3.17)   (size 1.5 2.5) (drill oval 0.9 1.8) (layers *.Cu *.Mask))
  (pad "R1" thru_hole rect (at 2.2 -0.83)  (size 1.5 2.5) (drill oval 0.9 1.8) (layers *.Cu *.Mask))
  (pad "R2" thru_hole rect (at 2.2 -4.17)  (size 1.5 2.5) (drill oval 0.9 1.8) (layers *.Cu *.Mask))
  (pad "S"  thru_hole rect (at -2.2 4.17)  (size 1.5 2.5) (drill oval 0.9 1.8) (layers *.Cu *.Mask))

  (pad "" np_thru_hole circle (at 0.02 -5.7)  (size 1.5 1.5) (drill 1.5) (layers *.Cu *.Mask))
  (pad "" np_thru_hole circle (at 0.08 1.32)  (size 1.5 1.5) (drill 1.5) (layers *.Cu *.Mask))

  (model "${KIPRJMOD}/MeetingHub-4-v2.3dshapes/Jack_3.5mm_PJ-3200B-4A_Horizontal.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 90)))
)
